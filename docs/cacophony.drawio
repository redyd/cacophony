        <mxCell id="U28-GrJAJs9y8m3uC5Kh-73" value="void authentificate(ClientConnection)&lt;div&gt;throws AuthentificationFailed()&lt;/div&gt;" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" parent="U28-GrJAJs9y8m3uC5Kh-71" vertex="1">
