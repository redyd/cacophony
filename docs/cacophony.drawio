        <mxCell id="U28-GrJAJs9y8m3uC5Kh-73" parent="U28-GrJAJs9y8m3uC5Kh-71" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="ClientConnection authentificate(SSLSocket)&lt;div&gt;throws AuthentificationFailed()&lt;/div&gt;" vertex="1">
